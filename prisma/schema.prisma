generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// 1. USER & IDENTITY DOMAIN
// ==========================================
model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique // References Supabase auth.users ID
  name      String
  phone     String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses    Address[]
  store        Store?
  cart         Cart?
  transactions Transaction[]
  reviews      ProductReview[]
  buyerConversations Conversation[] @relation("BuyerConversations")
  sentMessages       Message[]      @relation("SentMessages")
}

model Address {
  id        String  @id @default(uuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  label        String // e.g., "Rumah", "Kantor"
  receiverName String
  phone        String
  fullAddress  String
  cityId       String? // For RajaOngkir/Biteship API
  provinceId   String?
  province     String? // Nama provinsi (untuk cek ongkir sesama pulau)
  postalCode   String?
  isPrimary    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

// ==========================================
// 2. STORE & ESCROW DOMAIN
// ==========================================
model Store {
  id        String  @id @default(uuid())
  profileId String  @unique
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name        String
  domain      String  @unique
  description String?
  logoUrl     String?
  bannerUrl   String?
  cityId      String? // Origin city for shipping calculation
  province    String? // Nama provinsi toko (untuk cek sesama pulau)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
  orders   Order[]
  wallet   StoreWallet?
  conversations Conversation[] @relation("StoreConversations")
}

model StoreWallet {
  id      String  @id @default(uuid())
  storeId String  @unique
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  balance Decimal @default(0) @db.Decimal(12, 2)

  ledgers   WalletLedger[]
  updatedAt DateTime       @updatedAt
}

model WalletLedger {
  id            String      @id @default(uuid())
  storeWalletId String
  storeWallet   StoreWallet @relation(fields: [storeWalletId], references: [id], onDelete: Cascade)

  amount      Decimal @db.Decimal(12, 2) // Positive (Income) or Negative (Withdrawal/Fee)
  type        String // e.g., "ORDER_COMPLETED", "WITHDRAWAL", "PLATFORM_FEE"
  description String?
  referenceId String? // Could be Order ID or Withdrawal ID

  createdAt DateTime @default(now())
}

// ==========================================
// 3. PRODUCT & VARIANTS
// ==========================================
model Category {
  id       String     @id @default(uuid())
  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  name String
  slug String  @unique
  icon String?

  products Product[]
}

model Product {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  name        String
  slug        String @unique
  description String @db.Text
  weight      Int    @default(1000) // In grams, for shipping

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]
  images   ProductImage[]
  reviews  ProductReview[]
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name  String // e.g., "Merah - XL" or "Default" if no variation
  sku   String?
  price Decimal @db.Decimal(10, 2)
  stock Int     @default(0)

  cartItems  CartItem[]
  orderItems OrderItem[]
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url       String
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)
}

model ProductReview {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  profileId   String
  profile     Profile    @relation(fields: [profileId], references: [id])
  orderItemId String?    @unique // Ensures 1 review per purchased item
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])

  rating    Int      @default(5) // 1 to 5
  comment   String?  @db.Text
  imageUrls String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// 4. CART
// ==========================================
model Cart {
  id        String  @id @default(uuid())
  profileId String  @unique
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id     String @id @default(uuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantity Int     @default(1)
  selected Boolean @default(true) // For checkout selection
}

// ==========================================
// 5. TRANSACTION & ORDERS (Multi-Vendor Split)
// ==========================================
// Transaction is the parent covering the whole payment (e.g. Midtrans)
model Transaction {
  id        String  @id @default(uuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  paymentMethod String?
  paymentStatus String  @default("PENDING") // PENDING, PAID, FAILED, EXPIRED
  totalAmount   Decimal @db.Decimal(12, 2)
  paymentToken  String? // Snap Token Midtrans

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

// Order is split per Store. If I buy from 3 stores, 1 Transaction = 3 Orders
model Order {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  addressId String
  address   Address @relation(fields: [addressId], references: [id])

  status String @default("UNPAID") // UNPAID, PACKING, SHIPPED, COMPLETED, CANCELLED

  shippingCourier  String?  // e.g. "JNE REG"
  shippingCost     Decimal  @default(0) @db.Decimal(10, 2)
  shippingSubsidy  Decimal  @default(0) @db.Decimal(10, 2) // Subsidi ongkir dari platform
  trackingNumber   String?  // AWB / Resi dari Biteship
  pickupCode       String?  // Kode pickup dari Biteship
  biteshipOrderId  String?  // ID order di Biteship untuk tracking

  subtotal    Decimal @db.Decimal(12, 2)
  platformFee Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId String? // Optional in case product variant is deleted
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productName String // Snapshot of name
  variantName String // Snapshot of variant name
  price       Decimal @db.Decimal(10, 2) // Snapshot of price at purchase time
  quantity    Int

  review ProductReview?
}

// ==========================================
// 6. CHAT & MESSAGING
// ==========================================
model Conversation {
  id        String   @id @default(uuid())
  buyerId   String
  buyer     Profile  @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  
  storeId   String
  store     Store    @relation("StoreConversations", fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  Message[]

  @@unique([buyerId, storeId]) // 1 buyer and 1 store can only have 1 active conversation thread
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderProfileId String
  sender          Profile      @relation("SentMessages", fields: [senderProfileId], references: [id], onDelete: Cascade)

  content        String       @db.Text
  isRead         Boolean      @default(false)
  
  createdAt      DateTime     @default(now())
}

